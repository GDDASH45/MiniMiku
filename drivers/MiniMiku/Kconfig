menu "MiniMiku"

config MIKU_EGG
    tristate "Miku egg driver"
    default y
    help
      Enable the egg

config MIKU_TETO
    tristate "heehehehehe. :o"
    default n
    help
      Smithers, Release the chimeras

config MIKU_INTPANIC
    tristate "Intentional Panic Device"
    default y
    help
      Creates /dev/panic. Writing to ir panics the kernel.
      Intended for Developers.

source "drivers/MiniMiku/vendor/Kconfig"

endmenu
